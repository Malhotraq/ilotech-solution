# === IloTech Solution — contoh env ===
# Copy file ini jadi .env :
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/Mac)

# Password untuk login admin di /admin
# GANTI dengan password kuat milikmu!
ADMIN_PASSWORD=ganti-password-admin-disini

# Kunci rahasia untuk tanda tangan cookie admin (string acak panjang)
# Bikin acak, misal: openssl rand -hex 32
ADMIN_SECRET=ganti-secret-acak-minimal-32-karakter

# === Postgres (service `db` di docker-compose.yml) ===
# GANTI password ini! Hanya huruf+angka agar aman di dalam URL.
POSTGRES_USER=ilotech
POSTGRES_PASSWORD=GANTI-DENGAN-PASSWORD-ACAK-PANJANG
POSTGRES_DB=ilotech

# Koneksi database (dipakai aplikasi).
# - Docker: nilainya dibentuk otomatis oleh docker-compose.yml dari 3 var di atas.
# - Lokal tanpa Docker: isi manual ke Postgres lokal / Neon / Supabase,
#   contoh: postgres://user:pass@localhost:5432/ilotech
DATABASE_URL=postgres://ilotech:GANTI-DENGAN-PASSWORD-ACAK-PANJANG@db:5432/ilotech

# Link review Google (dari Google Business Profile → Bagikan → link review).
# Tampil sebagai tombol setelah pelanggan memberi rating. Kosongkan = disembunyikan.
# Wajib rebuild setelah ganti (NEXT_PUBLIC_* di-inline saat build).
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# Nomor WhatsApp admin (format 628xx, tanpa +)
# Dipakai server (link dinamis di halaman yang render saat request).
ADMIN_WA=62895803366608

# Nomor yang sama untuk BROWSER (tombol WA di HP pengunjung).
# WAJIB diisi juga karena Next.js hanya mengirim env berawalan NEXT_PUBLIC_ ke browser.
# Nilai ini di-inline saat BUILD -> setelah ganti, wajib rebuild:
#   lokal : restart `npm run dev` / build ulang
#   Docker: `docker compose up -d --build`
NEXT_PUBLIC_ADMIN_WA=62895803366608

# URL publik website (untuk link di notifikasi WA). Lokal: http://localhost:3000
# Produksi: https://domainmilikmu.id (tanpa garis miring di akhir)
SITE_URL=http://localhost:3000

# Notifikasi WA otomatis via Fonnte (opsional).
# Kosongkan = fitur WA otomatis mati, website tetap jalan normal.
# Isi dari dashboard Fonnte setelah hubungkan nomor: https://fonnte.com
FONNTE_TOKEN=

# Folder foto upload (opsional, default ./data/uploads).
# Docker: /app/data/uploads (otomatis ditimpa compose, ikut volume ./data).
UPLOAD_DIR=./data/uploads
