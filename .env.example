# === IloTech Solution — contoh env ===
# Copy file ini jadi .env :
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/Mac)

# Password untuk login admin di /admin
# GANTI dengan password kuat milikmu!
ADMIN_PASSWORD=ganti-password-admin-disini

# Kunci rahasia untuk tanda tangan cookie admin (string acak panjang)
# Bikin acak, misal: openssl rand -hex 32
ADMIN_SECRET=ganti-secret-acak-minimal-32-karakter

# Lokasi file database SQLite
# Lokal (Windows/XAMPP): ./data/ilotech.db
# Docker: /app/data/ilotech.db (sudah diatur di docker-compose.yml)
DB_PATH=./data/ilotech.db

# Nomor WhatsApp admin (format 628xx, tanpa +)
ADMIN_WA=62895803366608
